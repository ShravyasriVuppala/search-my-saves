# secrets — never commit real values, .env.example is the template
.env
.env.local
.env.*.local
pipeline/.env
web/.env
web/.env.local

# python
.venv/
venv/
__pycache__/
*.pyc
*.egg-info/
.pytest_cache/
.ruff_cache/

# node / next.js
node_modules/
web/.next/
web/out/
web/next-env.d.ts
*.tsbuildinfo

# auto-generated by `next dev` on every run -- not authored content
web/AGENTS.md

# ingestion artifacts — Apify raw dumps, Meta export, downloaded media.
# These are large, personal, and reproducible from Apify re-runs; keep them
# local only. raw_apify_data is preserved durably in Postgres instead.
data/

# scratch frame extraction (plan.md §8.5 — never persisted, but just in case
# a run is interrupted mid-extraction)
pipeline/*.mp4
pipeline/frame_*.jpg

# local planning docs — not versioned in the repo
CLAUDE.md
plan.md

# editor / OS
.idea/
.vscode/
.DS_Store
