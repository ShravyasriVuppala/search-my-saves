# Copy to .env and fill in. Never commit .env — it's gitignored.
# See plan.md §6 for what each of these is for and plan.md §4 for the
# free-tier budget that makes this whole project cost $0.

# ── Supabase ─────────────────────────────────────────────────────────────
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=              # service_role key, NOT anon. Server-only.
SUPABASE_STORAGE_BUCKET=      # create this bucket, keep it PRIVATE

# ── Gemini ───────────────────────────────────────────────────────────────
GEMINI_API_KEY=
GEMINI_ANALYSIS_MODEL=gemini-3.1-flash-lite     # preview model — plan.md D14/R1b
GEMINI_ANALYSIS_FALLBACK_MODEL=gemini-2.5-flash
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
GEMINI_EMBEDDING_DIM=768

# ── Apify (pipeline only, never deployed to Vercel) ─────────────────────
APIFY_TOKEN=

# ── App auth (web/) ──────────────────────────────────────────────────────
APP_PASSWORD=                # the single password gate — plan.md §10
APP_SESSION_SECRET=          # random string, used to HMAC the session cookie

# ── Worker / media tuning ────────────────────────────────────────────────
WORKER_RPM=10                # posts/min, not API calls/min (each post = 1 analysis
                             # + 1 embedding call, against separate model quotas).
                             # Free tier showed 15 RPM; check your own limits at
                             # https://aistudio.google.com/rate-limit
WORKER_CONCURRENCY=5         # posts analyzed in parallel; time per post is mostly
                             # network wait (video download + Gemini latency), so this
                             # is near-linear speedup. Combined rate still obeys WORKER_RPM.
WORKER_DAILY_CAP=400         # margin under the observed free-tier daily cap — the API
                             # reported 500 RPD for gemini-3.1-flash-lite, and note
                             # failed retries count against it too
WORKER_MAX_RETRIES=3
MEDIA_MAX_FRAMES=12
MEDIA_FRAME_WIDTH=480
MEDIA_FRAME_HEIGHT=854
VIDEO_MAX_MB=25              # above this, fall back to the thumbnail
